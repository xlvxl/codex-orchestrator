+import fs from "node:fs";
+import path from "node:path";
+import { ensureDir, readJsonIfExists, stateSubdir, writeSecureJson } from "../config/paths.js";
+
+export type AdviceKind = "plan" | "review";
+
+export interface AdviceResult {
+  taskId: string;
+  kind: AdviceKind;
+  content: string;
+  submittedAt: string;
+}
+
+const SAFE_ID = /^[A-Za-z0-9._-]{1,128}$/;
+
+function checkId(value: string, label: string): void {
+  if (!SAFE_ID.test(value)) throw new Error(`Invalid ${label}: ${value}`);
+}
+
+function adviceFile(workspaceId: string, taskId: string, kind: AdviceKind): string {
+  checkId(workspaceId, "workspace id");
+  checkId(taskId, "task id");
+  return path.join(stateSubdir("advice"), workspaceId, `${taskId}.${kind}.json`);
+}
+
+export function submitAdvice(
+  workspaceId: string,
+  taskId: string,
+  kind: AdviceKind,
+  content: string,
+): AdviceResult {
+  const text = content.trim();
+  if (!text) throw new Error("Advice content is empty");
+  if (Buffer.byteLength(text, "utf8") > 16 * 1024) {
+    throw new Error("Advice content exceeds 16 KiB");
+  }
+  const result: AdviceResult = {
+    taskId,
+    kind,
+    content: text,
+    submittedAt: new Date().toISOString(),
+  };
+  writeSecureJson(adviceFile(workspaceId, taskId, kind), result);
+  return result;
+}
+
+export function readAdvice(
+  workspaceId: string,
+  taskId: string,
+  kind: AdviceKind,
+): AdviceResult | null {
+  return readJsonIfExists<AdviceResult>(adviceFile(workspaceId, taskId, kind));
+}
+
+export function clearAdvice(workspaceId: string, taskId: string, kind: AdviceKind): void {
+  fs.rmSync(adviceFile(workspaceId, taskId, kind), { force: true });
+}
+
+export async function waitForAdvice(
+  workspaceId: string,
+  taskId: string,
+  kind: AdviceKind,
+  timeoutMs: number,
+): Promise<AdviceResult> {
+  const existing = readAdvice(workspaceId, taskId, kind);
+  if (existing) return existing;
+
+  const file = adviceFile(workspaceId, taskId, kind);
+  const directory = ensureDir(path.dirname(file));
+  return new Promise((accept, reject) => {
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    const watcher = fs.watch(directory, () => {
+      const result = readAdvice(workspaceId, taskId, kind);
+      if (result) finish(() => accept(result));
+    });
+    if (timeoutMs > 0) {
+      timer = setTimeout(() => {
+        finish(() => reject(new Error(`Timed out waiting for ${kind} advice`)));
+      }, timeoutMs);
+    }
+    const finish = (done: () => void): void => {
+      if (timer) clearTimeout(timer);
+      watcher.close();
+      done();
+    };
+  });
+}
