+++ b/tests/advice-cli.test.ts
@@ -0,0 +1,30 @@
+import { describe, expect, it } from "vitest";
+import path from "node:path";
+import { spawnSync } from "node:child_process";
+import { readAdvice, submitAdvice } from "../src/advice/store.js";
+import { Workspace } from "../src/workspace/manager.js";
+import { cleanup, isolateStateDir, makeTmpDir, makeGitRepo } from "./helpers.js";
+
+describe("advice CLI", () => {
+  it("prints one submitted result and removes the transient file", () => {
+    isolateStateDir();
+    const workspace = makeTmpDir("advice-cli");
+    makeGitRepo(workspace);
+    const id = new Workspace(workspace).id;
+    submitAdvice(id, "task-cli", "plan", "Change src/app.ts.");
+
+    const run = spawnSync(
+      path.join(process.cwd(), "node_modules", ".bin", "tsx"),
+      ["src/cli/index.ts", "advice", "wait", "-w", workspace, "--task", "task-cli", "--kind", "plan", "--json"],
+      { cwd: process.cwd(), encoding: "utf8", env: process.env },
+    );
+
+    expect(run.status).toBe(0);
+    expect(JSON.parse(run.stdout)).toMatchObject({
+      ok: true,
+      advice: { taskId: "task-cli", kind: "plan", content: "Change src/app.ts." },
+    });
+    expect(readAdvice(id, "task-cli", "plan")).toBeNull();
+    cleanup(workspace);
+  });
+});
diff --git a/tests/advice.test.ts b/tests/advice.test.ts
new file mode 100644
index 0000000..fb1a49d
--- /dev/null
+++ b/tests/advice.test.ts
@@ -0,0 +1,43 @@
+import { describe, expect, it } from "vitest";
+import { clearAdvice, readAdvice, submitAdvice, waitForAdvice } from "../src/advice/store.js";
+import { cleanup, isolateStateDir, makeTmpDir } from "./helpers.js";
+
+describe("advisor completion store", () => {
+  it("wakes a waiter after ChatGPT submits matching advice", async () => {
+    isolateStateDir();
+    const root = makeTmpDir("advice");
+    const pending = waitForAdvice("workspace-1", "task-1", "plan", 0);
+
+    setTimeout(() => {
+      submitAdvice("workspace-1", "task-1", "plan", "Inspect src/app.ts first.");
+    }, 25);
+
+    const result = await pending;
+    expect(result).toMatchObject({
+      taskId: "task-1",
+      kind: "plan",
+      content: "Inspect src/app.ts first.",
+    });
+    expect(readAdvice("workspace-1", "task-1", "plan")?.content).toBe(
+      "Inspect src/app.ts first.",
+    );
+
+    clearAdvice("workspace-1", "task-1", "plan");
+    expect(readAdvice("workspace-1", "task-1", "plan")).toBeNull();
+    cleanup(root);
+  });
+
+  it("rejects unsafe task ids", () => {
+    isolateStateDir();
+    expect(() => submitAdvice("workspace-1", "../task", "review", "No findings.")).toThrow(
+      /Invalid task id/,
+    );
+  });
+
+  it("rejects advice that cannot fit the Orchestrator result contract", () => {
+    isolateStateDir();
+    expect(() => submitAdvice("workspace-1", "task-large", "plan", "x".repeat(16_385))).toThrow(
+      /16 KiB/,
+    );
+  });
+});
